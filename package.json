{
  "name": "alu-factory-erp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3400",
    "build": "prisma generate && next build",
    "start": "next start -p 3400",
    "typecheck": "tsc --noEmit",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "npm run build:worker && wrangler deploy",
    "cf:setup": "bash scripts/cf-setup.sh",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@barba/core": "^2.10.3",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "headroom-ai": "^0.39.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.0.11",
    "jspdf": "^2.5.2",
    "next": "^15.5.4",
    "ogl": "^1.0.11",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
