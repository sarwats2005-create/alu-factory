# Copy to .env and fill in. NEVER commit the real .env.

# Pooled PostgreSQL connection string used by the app (Neon "pooled" URL).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (unpooled) connection used by Prisma migrations (Neon "direct" URL).
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Random string (32+ chars) used to sign JWT session cookies.
# Generate: openssl rand -base64 32
JWT_SECRET="change-me"
